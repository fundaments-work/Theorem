{
    "name": "theorem",
    "version": "1.0.0-7",
    "description": "Local-first reader for PDFs, EPUBs, and RSS with highlights and Markdown export.",
    "private": true,
    "author": "Fundamentals",
    "license": "MIT",
    "homepage": "https://github.com/fundaments-work/theorem",
    "repository": {
        "type": "git",
        "url": "https://github.com/fundaments-work/theorem.git"
    },
    "bugs": {
        "url": "https://github.com/fundaments-work/theorem/issues"
    },
    "keywords": [
        "reader",
        "epub",
        "pdf",
        "rss",
        "tauri",
        "ebook",
        "highlights",
        "annotations"
    ],
    "packageManager": "pnpm@10.18.1",
    "scripts": {
        "dev": "vite",
        "dev:tauri": "tauri dev",
        "build": "pnpm run typecheck && vite build",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "package:linux": "bash ./scripts/makepackage-linux.sh",
        "package:linux:all": "bash ./scripts/makepackage-linux.sh --bundle all",
        "install:linux": "bash ./scripts/install-linux.sh",
        "uninstall:linux": "bash ./scripts/uninstall-linux.sh",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "preview": "vite preview",
        "tauri": "tauri",
        "clean:tauri": "cargo clean --manifest-path src-tauri/Cargo.toml",
        "dev:android": "JAVA_HOME=/opt/android-studio/jbr ANDROID_HOME=$HOME/Android/Sdk pnpm tauri android dev",
        "build:android": "JAVA_HOME=/opt/android-studio/jbr ANDROID_HOME=$HOME/Android/Sdk pnpm tauri android build --debug"
    },
    "dependencies": {
        "@mozilla/readability": "^0.6.0",
        "@sentry/react": "^10.59.0",
        "@tanstack/react-virtual": "^3.14.3",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-app": "2.0.0-alpha.1",
        "@tauri-apps/plugin-barcode-scanner": "^2.4.5",
        "@tauri-apps/plugin-dialog": "^2.7.1",
        "@tauri-apps/plugin-fs": "^2.5.1",
        "@tauri-apps/plugin-http": "^2.5.9",
        "@tauri-apps/plugin-opener": "^2.5.4",
        "@tauri-apps/plugin-os": "^2.3.2",
        "@tauri-apps/plugin-window": "2.0.0-alpha.1",
        "@tauri-controls/react": "^0.4.0",
        "@types/uuid": "^10.0.0",
        "@zip.js/zip.js": "^2.8.26",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "fast-xml-parser": "^5.9.3",
        "fflate": "^0.8.3",
        "fuse.js": "^7.4.2",
        "html-to-image": "^1.11.13",
        "i18next": "^26.3.1",
        "i18next-browser-languagedetector": "^8.2.1",
        "idb-keyval": "^6.2.5",
        "lucide-react": "^1.21.0",
        "pdfjs-dist": "^6.0.227",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-i18next": "^17.0.8",
        "tailwind-merge": "^3.6.0",
        "uuid": "^14.0.1",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.1",
        "@tauri-apps/cli": "^2.11.3",
        "@types/node": "^26.0.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitest/coverage-v8": "^4.1.9",
        "jsdom": "^29.1.1",
        "tailwindcss": "^4.3.1",
        "typescript": "~6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^4.1.9"
    }
}
